{
  "name": "empleado-digital",
  "private": true,
  "version": "0.0.0",
  "description": "Empleado digital con IA para negocios locales en México (WhatsApp + agenda).",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "wa:webhook": "pnpm --filter @empleado/worker webhook",
    "wa:worker": "pnpm --filter @empleado/worker start",
    "wa:fake-graph": "pnpm --filter @empleado/worker dev:fake-graph",
    "wa:simulate": "pnpm --filter @empleado/worker dev:simulate",
    "wa:connect-channel": "pnpm --filter @empleado/worker connect-channel",
    "wa:templates": "pnpm --filter @empleado/worker templates",
    "wa:calling": "pnpm --filter @empleado/worker calling",
    "billing:reconcile": "pnpm --filter @empleado/worker reconcile",
    "chat": "pnpm --filter @empleado/agent chat",
    "web": "pnpm --filter @empleado/web dev",
    "web:build": "pnpm --filter @empleado/web build",
    "demo-data": "pnpm --filter @empleado/inbox demo-data",
    "set-password": "pnpm --filter @empleado/db set-password",
    "db:migrate": "pnpm --filter @empleado/db migrate",
    "db:seed": "pnpm --filter @empleado/db seed",
    "db:generate": "pnpm --filter @empleado/db generate",
    "db:operator": "pnpm --filter @empleado/db operator",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
