# Copia este archivo a .env y llena los valores. NUNCA subas .env a git.

# --- Infraestructura local (docker compose) ---
POSTGRES_USER=empleado
POSTGRES_PASSWORD=empleado_dev
POSTGRES_DB=empleado_digital
# Rol propietario: solo para migraciones y seed.
DATABASE_URL=postgresql://empleado:empleado_dev@localhost:5432/empleado_digital
REDIS_URL=redis://localhost:6379
# Rol de aplicacion (sin superusuario): es el que respeta Row Level Security.
APP_DB_PASSWORD=empleado_app_dev
DATABASE_APP_URL=postgresql://empleado_app:empleado_app_dev@localhost:5432/empleado_digital

# --- Seguridad ---
# 32 bytes en base64 para AES-256-GCM. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Secreto de sesiones (Auth.js). Genera otro valor distinto.
AUTH_SECRET=

# --- WhatsApp Cloud API (Meta) ---
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256 de los webhooks.
META_APP_SECRET=
# Texto que tú inventas; Meta lo envía al verificar el webhook (hub.verify_token).
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API a usar.
GRAPH_API_VERSION=v23.0
# SOLO desarrollo: apunta a un Graph API falso (pnpm --filter @empleado/worker dev:fake-graph). Vacio = WhatsApp real.
GRAPH_BASE_URL=
# Puerto del servidor del webhook.
WEBHOOK_PORT=3001
# Prefijo de las colas en Redis.
QUEUE_PREFIX=empleado

# --- LLM ---
# free = SOLO modelos gratuitos (pruebas; limites bajos y sin datos reales). paid = segun el nivel del negocio.
LLM_MODE=paid
OPENROUTER_API_KEY=

# --- Google Calendar (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
APP_URL=http://localhost:3000

# Contrasena del usuario demo del panel (demo@sonrisa.test). Solo desarrollo; minimo 10 caracteres.
DEMO_OWNER_PASSWORD=

# ---- Cobro de suscripciones (Mercado Pago) ----
# Access Token y clave secreta del webhook de tu aplicacion en https://www.mercadopago.com.mx/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Direccion publica del panel (a donde Mercado Pago regresa al cliente). Sin ruta final.
PUBLIC_BASE_URL=

# ---- Messenger / Instagram (Iniciar sesion con Facebook) ----
# Identificador de tu aplicacion de Meta (Configuracion de la app > Basica). El App Secret ya esta en META_APP_SECRET.
META_APP_ID=
